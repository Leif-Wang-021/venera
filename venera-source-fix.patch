+/// Venera native backup metadata.
+///
+/// Unlike the flat CBZ `metadata.json`, this keeps the exact chapter map used
+/// by `LocalComic`, so importing on another device can restore chapter names
+/// and groups correctly.
+class VeneraNativeMeta {
+  final String title;
+
+  final String author;
+
+  final List<String> tags;
+
+  final Map<String, dynamic> chapters;
+
+  final List<String> downloadedChapters;
+
+  final String cover;
+
+  final DateTime? createdAt;
+
+  VeneraNativeMeta({
+    required this.title,
+    required this.author,
+    required this.tags,
+    required this.chapters,
+    required this.downloadedChapters,
+    required this.cover,
+    this.createdAt,
+  });
+
+  factory VeneraNativeMeta.fromJson(Map<String, dynamic> json) {
+    return VeneraNativeMeta(
+      title: json['title'] as String,
+      author: (json['author'] as String?) ?? '',
+      tags: (json['tags'] as List?)?.cast<String>() ?? [],
+      chapters: (json['chapters'] as Map?)?.cast<String, dynamic>() ?? {},
+      downloadedChapters:
+          (json['downloadedChapters'] as List?)?.cast<String>() ?? [],
+      cover: (json['cover'] as String?) ?? '',
+      createdAt: json['createdAt'] == null
+          ? null
+          : DateTime.fromMillisecondsSinceEpoch(json['createdAt'] as int),
+    );
+  }
+
+  Map<String, dynamic> toJson() => {
+        'title': title,
+        'author': author,
+        'tags': tags,
+        'chapters': chapters,
+        'downloadedChapters': downloadedChapters,
+        'cover': cover,
+        'createdAt': createdAt?.millisecondsSinceEpoch,
+      };
+}
