     static defaultApiUrl = 'api.2024manga.com'
 
+    // 自适应限流状态
+    static _lastRequestTime = 0;
+    static _minInterval = 800;
+
+    static async _throttle() {
+        const now = Date.now();
+        const wait = HotManga._minInterval - (now - HotManga._lastRequestTime);
+        if (wait > 0) {
+            await new Promise((resolve) => setTimeout(resolve, wait));
+        }
+        HotManga._lastRequestTime = Date.now();
+    }
+
+    static _onSuccess() {
+        HotManga._minInterval = Math.max(800, HotManga._minInterval - 200);
+    }
+
+    static _onThrottled(waitTime) {
+        HotManga._minInterval = Math.min(5000, HotManga._minInterval + 500);
+        if (waitTime > HotManga._minInterval) {
+            HotManga._minInterval = Math.min(5000, waitTime);
+        }
+    }
+
