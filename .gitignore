# ---- personal session archives ----
*.zip
dsh-session-*.zip
session.jsonl

# ---- git history backups ----
.git_backups/

# ---- build / tooling artifacts ----
build/
dist/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.idea/
*.iml

# ---- OS junk ----
.DS_Store
Thumbs.db
desktop.ini
*.dmp

# ---- local experiments (not part of the public fork) ----
/ratelimit_task/

# ---- Python artifacts ----
__pycache__/
*.pyc
*.pyo

# ---- HarmonyOS / OHOS build artifacts ----
node_modules/
oh_modules/
.hvigor/
.preview/
.cxx/
local.properties
oh-package-lock.json5
**/libs/**/*.so

# ---- local debug tools ----
/tools/procdump.exe

# ---- 本地工作记录与临时目录 ----
# 历史 log/ 下已入库的开发记录保持跟踪；此后新增的日志不再入库
log/
# 临时输出目录
out/
/.v2c/

